{
  "_comment": "Example tool definitions for mcp_http_bridge.py. Copy to tools/http_tools.json in the project and edit. Add one object per API endpoint you want the AI to be able to call.",

  "tools": [
    {
      "name": "get_weather",
      "description": "查询指定城市的当前天气。当用户问天气时调用。",
      "url": "https://api.open-meteo.com/v1/forecast",
      "method": "GET",
      "params": {
        "latitude":  { "type": "number", "description": "纬度，例如北京 39.9", "required": true },
        "longitude": { "type": "number", "description": "经度，例如北京 116.4", "required": true }
      },
      "query": {
        "latitude": "{latitude}",
        "longitude": "{longitude}",
        "current": "temperature_2m,relative_humidity_2m,wind_speed_10m"
      },
      "timeout": 15,
      "max_chars": 2000
    },

    {
      "name": "example_post_api",
      "description": "这是一个 POST 示例（把 url 换成你自己的接口后启用）。",
      "url": "https://httpbin.org/post",
      "method": "POST",
      "params": {
        "text": { "type": "string", "description": "要发送的文本", "required": true }
      },
      "headers": {
        "Authorization": "Bearer YOUR_TOKEN_HERE"
      },
      "body": {
        "message": "{text}",
        "source": "open-llm-vtuber"
      },
      "timeout": 20,
      "max_chars": 3000
    }
  ]
}
